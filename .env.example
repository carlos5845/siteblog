# Configuración de Publicidad y Analítica para DigitalStack

# 1. Google AdSense (Monetización web)
# Formato: ca-pub-XXXXXXXXXXXXXXXX (16 dígitos numéricos)
PUBLIC_ADSENSE_CLIENT_ID=

# 2. Google Ads (Campañas y Conversiones de Google Ads)
# Formato: AW-XXXXXXXXX
PUBLIC_GOOGLE_ADS_ID=

# 3. Google Analytics 4 (Métricas y Tráfico de Visitantes)
# Formato: G-XXXXXXXXXX
PUBLIC_GA_ID=
