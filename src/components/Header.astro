---
import { siteConfig } from '../config/site';
import SearchModal from './ui/SearchModal';

const currentPath = Astro.url.pathname;

function isActive(path: string) {
  if (path === '/' && currentPath === '/') return true;
  if (path !== '/' && currentPath.startsWith(path)) return true;
  return false;
}
---

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-md transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 py-2">
      
      {/* Logotipo Minimalista / Neo-Editorial */}
      <div class="flex items-center gap-8 shrink-0">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-black text-white flex items-center justify-center font-black text-sm tracking-tighter group-hover:bg-slate-800 transition-colors">
            DS
          </div>
          <span class="text-xl font-black tracking-tight text-slate-900 uppercase">
            {siteConfig.name}
          </span>
        </a>
      </div>

      {/* Navegación Desktop Centrada y en Una Sola Línea (Zero Line Breaks) */}
      <nav class="hidden md:flex items-center gap-1 text-sm font-bold text-slate-600">
        {siteConfig.navLinks.map((link, idx) => {
          const active = isActive(link.href);
          return (
            <div class="flex items-center">
              {idx > 0 && <span class="mx-2 text-slate-300 text-xs select-none">•</span>}
              <a
                href={link.href}
                class={`whitespace-nowrap px-3.5 py-1.5 rounded-full transition-all ${
                  active
                    ? 'text-slate-900 font-black bg-slate-100 shadow-xs'
                    : 'hover:text-slate-900 hover:bg-slate-50'
                }`}
              >
                {link.name}
              </a>
            </div>
          );
        })}
      </nav>

      {/* Acciones a la Derecha: Buscador Funcional + Botón Calculadora */}
      <div class="flex items-center gap-3 shrink-0">
        
        {/* Buscador Interactivo Modal (Cmd + K) */}
        <SearchModal client:load />

        {/* Botón Píldora de Acción Principal */}
        <a
          href="/utilidades/calculadora-tokens-ia"
          class="hidden sm:inline-flex items-center gap-1.5 whitespace-nowrap px-5 py-2.5 rounded-full text-xs font-black uppercase tracking-wide bg-black text-white hover:bg-slate-800 transition-all shadow-sm hover:scale-[1.02] active:scale-95"
        >
          <span>Calculadora IA</span>
          <span class="text-sm font-normal">↗</span>
        </a>

        {/* Botón Menú Móvil */}
        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden p-2 rounded-full text-slate-700 hover:text-black hover:bg-slate-100 focus:outline-none"
          aria-label="Abrir menú"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  {/* Menú desplegable Móvil */}
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-2">
    {siteConfig.navLinks.map((link) => {
      const active = isActive(link.href);
      return (
        <a
          href={link.href}
          class={`block px-4 py-2.5 rounded-xl text-base font-bold ${
            active
              ? 'text-black bg-slate-100'
              : 'text-slate-700 hover:text-black hover:bg-slate-50'
          }`}
        >
          {link.name}
        </a>
      );
    })}
    <div class="pt-3 border-t border-slate-100">
      <a
        href="/utilidades/calculadora-tokens-ia"
        class="flex items-center justify-between w-full px-5 py-3 rounded-full text-sm font-extrabold uppercase bg-black text-white"
      >
        <span>Probar Calculadora IA</span>
        <span>↗</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
