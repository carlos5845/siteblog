---
import { siteConfig } from '../config/site';

interface Props {
  slotId?: string;
  format?: 'leaderboard' | 'rectangle' | 'in-feed';
  label?: string;
  className?: string;
}

const {
  slotId = 'default-slot',
  format = 'leaderboard',
  label = 'Publicidad',
  className = '',
} = Astro.props;

// Dimensiones fijas para evitar CLS (Cumulative Layout Shift) en Core Web Vitals
const formatClasses = {
  leaderboard: 'w-full max-w-4xl min-h-[90px]',
  rectangle: 'w-full max-w-[336px] min-h-[280px]',
  'in-feed': 'w-full max-w-2xl min-h-[120px]',
};

const hasAdSense = Boolean(siteConfig.adSenseClientId);
---

<div class={`my-8 flex flex-col items-center justify-center ${className}`}>
  <span class="text-[10px] uppercase tracking-widest text-slate-400 font-bold mb-1.5">{label}</span>
  <div
    class={`relative flex items-center justify-center rounded-2xl border border-slate-200 bg-white shadow-xs overflow-hidden text-center transition-colors hover:border-slate-300 ${formatClasses[format]}`}
    data-ad-slot={slotId}
  >
    {hasAdSense ? (
      <>
        <ins
          class="adsbygoogle"
          style="display:block; width:100%;"
          data-ad-client={siteConfig.adSenseClientId}
          data-ad-slot={slotId}
          data-ad-format="auto"
          data-full-width-responsive="true"
        />
        <script is:inline>
          try {
            (adsbygoogle = window.adsbygoogle || []).push({});
          } catch (e) {}
        </script>
      </>
    ) : (
      <div class="px-4 py-4 flex flex-col items-center gap-1 text-slate-400">
        <div class="flex items-center gap-2 text-xs font-mono font-medium text-slate-500">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Google AdSense Slot ({format})</span>
        </div>
        <p class="text-[11px] text-slate-400 hidden sm:block">
          Espacio reservado con Zero CLS. Se activará automáticamente al configurar tu ID en el archivo .env
        </p>
      </div>
    )}
  </div>
</div>
