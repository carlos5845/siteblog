---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';

const topics = [
  {
    title: 'n8n & Workflows Auto-alojados',
    desc: 'Instalación con Docker, configuración de nodos de webhook, agentes de IA y automatización sin límites de ejecuciones.',
    link: '/guias',
    tag: 'n8n',
    tagBg: 'bg-[#bbf7d0] text-[#166534]',
  },
  {
    title: 'Make (Integromat)',
    desc: 'Escenarios visuales, routers avanzados, iteradores y conexiones webhook a servicios externos.',
    link: '/guias',
    tag: 'Make',
    tagBg: 'bg-[#ede9fe] text-[#6b21a8]',
  },
  {
    title: 'APIs, Webhooks & Automatización con Código',
    desc: 'Cómo conectar sistemas mediante llamadas HTTP REST, autenticación OAuth y scripts en TypeScript/Python.',
    link: '/guias',
    tag: 'APIs',
    tagBg: 'bg-[#bae6fd] text-[#075985]',
  },
  {
    title: 'Comparativa: n8n vs Make vs Zapier',
    desc: '¿Cuál es la mejor herramienta para tu volumen de datos y requerimientos de privacidad?',
    link: '/comparativas',
    tag: 'Comparativa',
    tagBg: 'bg-[#fef08a] text-[#854d0e]',
  },
];
---

<Layout
  title="Automatización de Flujos de Trabajo: n8n, Make y APIs"
  description="Aprende a conectar herramientas y automatizar tareas repetitivas usando n8n, Make, Zapier y webhooks para optimizar tu tiempo."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <div class="max-w-3xl mb-10">
      <span class="inline-block px-3.5 py-1 rounded-full bg-slate-100 text-slate-800 text-xs font-black uppercase tracking-wider mb-3">
        Productividad a Escala
      </span>
      <h1 class="text-3xl sm:text-6xl font-black text-slate-900 tracking-tight uppercase">
        Automatización
      </h1>
      <p class="text-slate-500 font-medium text-sm sm:text-base mt-3 leading-relaxed">
        Domina las plataformas modernas de automatización para orquestar datos, integrar servicios y delegar tareas complejas a flujos desatendidos.
      </p>
    </div>

    <AdBanner format="leaderboard" slotId="auto-top-banner" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
      {topics.map((item) => (
        <a
          href={item.link}
          class="p-8 rounded-[2rem] border border-slate-200 bg-white hover:border-slate-400 hover:shadow-md transition-all group flex flex-col justify-between"
        >
          <div>
            <span class={`inline-block text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full mb-4 ${item.tagBg}`}>
              {item.tag}
            </span>
            <h3 class="text-xl sm:text-2xl font-black text-slate-900 uppercase tracking-tight group-hover:text-emerald-600 transition-colors">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 font-medium mt-2 leading-relaxed">
              {item.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-black uppercase text-slate-900">
            <span>Ver artículos</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <AdBanner format="in-feed" slotId="auto-bottom-banner" />
  </div>
</Layout>
