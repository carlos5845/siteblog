---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página No Encontrada (404) | DigitalStack"
  description="La página que buscas no existe o ha sido movida."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="p-10 sm:p-16 rounded-[2.5rem] border border-slate-200 bg-white shadow-sm max-w-2xl mx-auto">
      <span class="inline-block px-3.5 py-1 rounded-full bg-[#fef08a] text-[#854d0e] text-xs font-black uppercase tracking-wider mb-4">
        Error 404
      </span>
      <h1 class="text-6xl sm:text-8xl font-black text-slate-900 tracking-tighter uppercase font-mono">
        404
      </h1>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight mt-4">
        Página No Encontrada
      </h2>
      <p class="text-sm font-medium text-slate-500 mt-2 max-w-md mx-auto">
        El enlace que has seguido puede estar roto o la página fue reubicada en nuestro directorio.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="px-6 py-3 rounded-full text-xs font-black uppercase bg-black text-white hover:bg-slate-800 transition-all shadow-sm"
        >
          Volver al Inicio →
        </a>
        <a
          href="/utilidades/calculadora-tokens-ia"
          class="px-6 py-3 rounded-full text-xs font-black uppercase bg-slate-100 text-slate-800 hover:bg-slate-200 transition-colors"
        >
          Probar Calculadora IA
        </a>
      </div>
    </div>
  </div>
</Layout>
