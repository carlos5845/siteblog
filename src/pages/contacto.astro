---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
---

<Layout
  title={`Contacto & Soporte | ${siteConfig.name}`}
  description={`Ponte en contacto con el equipo editorial de ${siteConfig.name} para sugerencias, colaboraciones y soporte.`}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="text-center mb-10">
      <span class="inline-block px-3.5 py-1 rounded-full bg-slate-100 text-slate-800 text-xs font-black uppercase tracking-wider mb-3">
        Estamos a tu disposición
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight uppercase">
        Contacto y Soporte
      </h1>
      <p class="text-slate-500 font-medium text-sm mt-3">
        ¿Tienes una propuesta de colaboración, encontraste una errata en un tutorial o deseas que analicemos tu software?
      </p>
    </div>

    <div class="p-8 sm:p-10 rounded-[2.5rem] border border-slate-200 bg-white shadow-sm space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-2">Nombre</label>
          <input
            type="text"
            placeholder="Tu nombre"
            class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3.5 text-sm text-slate-900 font-medium focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>
        <div>
          <label class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-2">Correo Electrónico</label>
          <input
            type="email"
            placeholder="tu@correo.com"
            class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3.5 text-sm text-slate-900 font-medium focus:outline-none focus:ring-2 focus:ring-black"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-2">Motivo de Contacto</label>
        <select class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3.5 text-sm text-slate-900 font-bold focus:outline-none focus:ring-2 focus:ring-black cursor-pointer">
          <option>Consulta general o sugerencia</option>
          <option>Postular una herramienta para el directorio</option>
          <option>Propuesta comercial o patrocinio</option>
          <option>Reportar un problema técnico</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-black uppercase tracking-wider text-slate-700 mb-2">Mensaje</label>
        <textarea
          rows="5"
          placeholder="Escribe tu mensaje aquí..."
          class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3.5 text-sm text-slate-900 font-medium focus:outline-none focus:ring-2 focus:ring-black"
        ></textarea>
      </div>

      <button
        type="button"
        class="w-full py-4 px-6 rounded-full font-black text-xs uppercase tracking-wide bg-black text-white hover:bg-slate-800 transition-all shadow-sm"
      >
        Enviar Mensaje →
      </button>
    </div>
  </div>
</Layout>
