---
import Layout from '../layouts/Layout.astro';
import AdBanner from '../components/AdBanner.astro';

const apps = [
  {
    title: 'Notion & Sistemas de Organización',
    desc: 'Arquitecturas tipo PARA, bases de datos conectadas y gestión de proyectos para equipos y creadores.',
    link: '/herramientas',
    tag: 'Notion',
    tagBg: 'bg-[#fef9c3] text-[#713f12]',
  },
  {
    title: 'Herramientas de Desarrollo y Editores IA',
    desc: 'Cursor, Claude Code, GitHub Copilot y extensiones que aumentan la velocidad de programación.',
    link: '/herramientas',
    tag: 'Desarrollo',
    tagBg: 'bg-[#fce7f3] text-[#9d174d]',
  },
  {
    title: 'Plantillas y Prompts Descargables',
    desc: 'Bases de Notion, hojas de cálculo de seguimiento y checklists de productividad listos para duplicar.',
    link: '/recursos',
    tag: 'Recursos',
    tagBg: 'bg-[#dcfce7] text-[#15803d]',
  },
  {
    title: 'Comparativa de Software de Trabajo',
    desc: 'Análisis de metodologías y suites de software para elegir la mejor herramienta.',
    link: '/comparativas',
    tag: 'Comparativa',
    tagBg: 'bg-[#ede9fe] text-[#6b21a8]',
  },
];
---

<Layout
  title="Productividad Digital: Sistemas, Metodologías y Software"
  description="Multiplica tu enfoque y rendimiento con los mejores sistemas de gestión, software de notas, editores inteligentes y plantillas."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <div class="max-w-3xl mb-10">
      <span class="inline-block px-3.5 py-1 rounded-full bg-slate-100 text-slate-800 text-xs font-black uppercase tracking-wider mb-3">
        Optimización & Enfoque
      </span>
      <h1 class="text-3xl sm:text-6xl font-black text-slate-900 tracking-tight uppercase">
        Productividad Digital
      </h1>
      <p class="text-slate-500 font-medium text-sm sm:text-base mt-3 leading-relaxed">
        Estrategias probadas, software minimalista y flujos de trabajo diseñados para reducir la fricción mental y entregar resultados de alto impacto.
      </p>
    </div>

    <AdBanner format="leaderboard" slotId="prod-top-banner" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
      {apps.map((item) => (
        <a
          href={item.link}
          class="p-8 rounded-[2rem] border border-slate-200 bg-white hover:border-slate-400 hover:shadow-md transition-all group flex flex-col justify-between"
        >
          <div>
            <span class={`inline-block text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full mb-4 ${item.tagBg}`}>
              {item.tag}
            </span>
            <h3 class="text-xl sm:text-2xl font-black text-slate-900 uppercase tracking-tight group-hover:text-emerald-600 transition-colors">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 font-medium mt-2 leading-relaxed">
              {item.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-black uppercase text-slate-900">
            <span>Ver guías</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <AdBanner format="in-feed" slotId="prod-bottom-banner" />
  </div>
</Layout>
