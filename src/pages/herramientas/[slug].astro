---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import { TOOLS_DATA, type SoftwareTool } from '../../data/tools';

export function getStaticPaths() {
  return TOOLS_DATA.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: SoftwareTool;
}

const { tool } = Astro.props;

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  description: tool.tagline,
  applicationCategory: tool.category,
  operatingSystem: 'All',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: tool.rating.toString(),
    reviewCount: '150',
    bestRating: '5',
    worstRating: '1',
  },
  offers: {
    '@type': 'Offer',
    price: tool.pricingType === 'Open Source' || tool.pricingType === 'Gratis' ? '0' : '20',
    priceCurrency: 'USD',
  },
};
---

<Layout
  title={`${tool.name} — Análisis, Opiniones, Precios y Alternativas`}
  description={tool.tagline}
  schema={toolSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    {/* Migas de pan */}
    <nav class="flex items-center gap-2 text-xs font-bold text-slate-500 mb-6 uppercase tracking-wider">
      <a href="/" class="hover:text-black">Inicio</a>
      <span>/</span>
      <a href="/herramientas" class="hover:text-black">Herramientas</a>
      <span>/</span>
      <span class="text-black font-black">{tool.name}</span>
    </nav>

    {/* Hero de la Herramienta */}
    <div class="p-8 sm:p-12 rounded-[2.5rem] border border-slate-200 bg-white shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-8 mb-10">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-4">
          <span class={`text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full ${tool.tagBg}`}>
            {tool.category}
          </span>
          <span class="text-xs font-bold font-mono text-slate-600 bg-slate-100 px-3 py-1 rounded-full">
            ★ {tool.rating} / 5.0
          </span>
          <span class="text-xs font-bold text-slate-400">
            {tool.pricingType}
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight uppercase">
          {tool.name}
        </h1>

        <p class="text-sm sm:text-base text-slate-600 font-medium mt-3 leading-relaxed">
          {tool.tagline}
        </p>

        <div class="flex flex-wrap gap-2 mt-5">
          {tool.tags.map((tag) => (
            <span class="text-[11px] font-semibold px-2.5 py-1 rounded-md bg-slate-50 text-slate-600 border border-slate-100">
              #{tag}
            </span>
          ))}
        </div>
      </div>

      <div class="shrink-0 flex flex-col gap-3">
        <a
          href={tool.websiteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 rounded-full font-black text-xs uppercase tracking-wide bg-black text-white hover:bg-slate-800 transition-all shadow-md text-center flex items-center justify-center gap-2"
        >
          <span>Visitar Sitio Oficial</span>
          <span>↗</span>
        </a>
        <a
          href="/comparativas"
          class="px-8 py-3 rounded-full font-bold text-xs uppercase tracking-wide bg-slate-100 text-slate-800 hover:bg-slate-200 transition-colors text-center"
        >
          Comparar con otras apps
        </a>
      </div>
    </div>

    <AdBanner format="leaderboard" slotId={`tool-${tool.slug}-top`} />

    {/* Descripción en Profundidad */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 my-10 max-w-6xl mx-auto">
      
      <div class="lg:col-span-8 space-y-10">
        
        <section class="space-y-4">
          <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tight">
            ¿Qué es {tool.name} y cómo funciona?
          </h2>
          <p class="text-slate-700 leading-relaxed text-sm sm:text-base font-medium">
            {tool.description}
          </p>
        </section>

        {/* Pros y Contras */}
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-3xl bg-[#dcfce7] border border-[#bbf7d0]">
            <h3 class="text-sm font-black uppercase tracking-wider text-[#15803d] mb-4">
              ✓ Ventajas y Pros
            </h3>
            <ul class="space-y-2.5 text-xs sm:text-sm font-medium text-[#14532d]">
              {tool.pros.map((pro) => (
                <li class="flex items-start gap-2">
                  <span class="font-bold">•</span>
                  <span>{pro}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="p-6 rounded-3xl bg-slate-50 border border-slate-200">
            <h3 class="text-sm font-black uppercase tracking-wider text-slate-700 mb-4">
              ✕ Puntos a Mejorar / Contras
            </h3>
            <ul class="space-y-2.5 text-xs sm:text-sm font-medium text-slate-600">
              {tool.cons.map((con) => (
                <li class="flex items-start gap-2">
                  <span class="font-bold">•</span>
                  <span>{con}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        {/* In-Article AdBanner */}
        <AdBanner format="in-feed" slotId={`tool-${tool.slug}-mid`} />

        {/* Planes de Precios */}
        <section class="space-y-6">
          <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tight">
            Planes y Precios de {tool.name}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {tool.pricingPlans.map((plan) => (
              <div class="p-6 rounded-3xl border border-slate-200 bg-white shadow-sm flex flex-col justify-between">
                <div>
                  <h3 class="text-base font-black text-slate-900 uppercase">{plan.name}</h3>
                  <div class="text-xl font-black text-slate-900 font-mono mt-2">{plan.price}</div>
                  <ul class="mt-4 space-y-2 text-xs text-slate-600 font-medium">
                    {plan.features.map((feat) => (
                      <li class="flex items-center gap-1.5">
                        <span class="text-emerald-600 font-bold">✓</span>
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* Casos de Uso Recomendados */}
        <section class="p-8 rounded-[2rem] bg-white border border-slate-200 shadow-sm space-y-3">
          <h2 class="text-xl font-black text-slate-900 uppercase tracking-tight">
            Casos de Uso Ideales
          </h2>
          <ul class="space-y-2 text-xs sm:text-sm font-medium text-slate-700">
            {tool.bestUseCases.map((uc) => (
              <li class="flex items-start gap-2">
                <span class="text-black font-bold">→</span>
                <span>{uc}</span>
              </li>
            ))}
          </ul>
        </section>

      </div>

      {/* Columna Lateral Derecha */}
      <aside class="lg:col-span-4 space-y-6">
        
        {/* Ficha Resumen */}
        <div class="p-6 rounded-[2rem] border border-slate-200 bg-white shadow-sm space-y-4">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-900 border-b border-slate-100 pb-2">
            Ficha Técnica
          </h3>
          <div class="space-y-3 text-xs font-medium">
            <div class="flex justify-between">
              <span class="text-slate-400">Categoría:</span>
              <span class="font-bold text-slate-900">{tool.category}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Modelo de Precios:</span>
              <span class="font-bold text-slate-900">{tool.pricingType}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Valoración Editorial:</span>
              <span class="font-bold text-emerald-700">{tool.rating} / 5.0</span>
            </div>
          </div>
        </div>

        {/* Alternativas Directas */}
        <div class="p-6 rounded-[2rem] border border-slate-200 bg-white shadow-sm space-y-4">
          <h3 class="text-xs font-black uppercase tracking-wider text-slate-900 border-b border-slate-100 pb-2">
            Alternativas Principales
          </h3>
          <div class="space-y-2">
            {tool.alternatives.map((alt) => (
              <a
                href={alt.link}
                class="flex items-center justify-between p-3 rounded-xl bg-slate-50 hover:bg-slate-100 text-xs font-bold text-slate-900 transition-colors"
              >
                <span>{alt.name}</span>
                <span>→</span>
              </a>
            ))}
          </div>
        </div>

      </aside>

    </div>

  </div>
</Layout>
