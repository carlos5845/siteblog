---
import Layout from '../../layouts/Layout.astro';
import AdBanner from '../../components/AdBanner.astro';
import CodeTerminal from '../../components/ui/CodeTerminal';
import N8nWorkflowViewer from '../../components/ui/N8nWorkflowViewer';
import { GUIDES_DATA, type GuideArticle } from '../../data/guides';

export function getStaticPaths() {
  return GUIDES_DATA.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: GuideArticle;
}

const { guide } = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: guide.title,
  description: guide.description,
  author: {
    '@type': 'Organization',
    name: guide.author,
  },
  datePublished: '2026-11-14',
  proficiencyLevel: 'Intermediate',
};
---

<Layout
  title={`${guide.title} | Guías DigitalStack`}
  description={guide.description}
  schema={articleSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    {/* Migas de pan */}
    <nav class="flex items-center gap-2 text-xs font-bold text-slate-500 mb-6 uppercase tracking-wider">
      <a href="/" class="hover:text-black">Inicio</a>
      <span>/</span>
      <a href="/guias" class="hover:text-black">Guías</a>
      <span>/</span>
      <span class="text-black font-black truncate max-w-xs">{guide.title}</span>
    </nav>

    {/* Encabezado Editorial */}
    <div class="max-w-4xl mx-auto text-center mb-10">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class={`text-[10px] font-black uppercase tracking-wider px-3.5 py-1 rounded-full ${guide.pillBg}`}>
          {guide.category}
        </span>
        <span class="text-xs font-bold text-slate-500">
          {guide.readTime}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight uppercase leading-tight">
        {guide.title}
      </h1>

      <p class="text-sm sm:text-base text-slate-600 font-medium mt-4 max-w-2xl mx-auto leading-relaxed">
        {guide.description}
      </p>

      <div class="mt-6 text-xs font-bold text-slate-400">
        Por <span class="text-slate-900">{guide.author}</span> • Publicado el {guide.date}
      </div>
    </div>

    <AdBanner format="leaderboard" slotId={`guide-${guide.slug}-top`} />

    {/* Contenido en 2 columnas: Índice + Artículo */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 my-10 max-w-6xl mx-auto">
      
      {/* Columna Lateral Izquierda: Tabla de Contenidos Sticky */}
      <aside class="hidden lg:block lg:col-span-4">
        <div class="sticky top-28 p-6 rounded-[2rem] border border-slate-200 bg-white shadow-sm space-y-4">
          <span class="text-xs font-black uppercase tracking-wider text-slate-900 block border-b border-slate-100 pb-2">
            Índice de la Guía
          </span>
          <nav class="space-y-2 text-xs font-bold text-slate-600">
            {guide.toc.map((item) => (
              <a
                href={`#${item.id}`}
                class="block py-1 hover:text-black hover:translate-x-1 transition-all"
              >
                {item.text}
              </a>
            ))}
          </nav>

          <div class="pt-4 border-t border-slate-100 space-y-2">
            <span class="text-[10px] font-black uppercase text-slate-400 block mb-1">Utilidades Relacionadas:</span>
            <a
              href="/utilidades/calculadora-tokens-ia"
              class="block p-3 rounded-xl bg-[#dcfce7] border border-[#bbf7d0] text-xs font-bold text-[#14532d] hover:bg-[#bbf7d0] transition-colors"
            >
              Calculadora de Costos IA ↗
            </a>
            <a
              href="/utilidades/optimizador-prompts-ia"
              class="block p-3 rounded-xl bg-[#fef9c3] border border-[#fef08a] text-xs font-bold text-[#713f12] hover:bg-[#fef08a] transition-colors"
            >
              Optimizador de Prompts ↗
            </a>
          </div>
        </div>
      </aside>

      {/* Columna Principal: Cuerpo del Tutorial */}
      <article class="lg:col-span-8 space-y-10">
        
        {guide.contentSections.map((sec, idx) => (
          <section id={sec.id} class="space-y-4 pt-2">
            <h2 class="text-2xl sm:text-3xl font-black text-slate-900 uppercase tracking-tight">
              {sec.heading}
            </h2>
            
            <p class="text-slate-700 leading-relaxed text-sm sm:text-base font-medium">
              {sec.body}
            </p>

            {/* Lienzo Interactivo de n8n si la sección lo solicita */}
            {sec.showWorkflowViewer && (
              <div class="my-6">
                <N8nWorkflowViewer client:load />
              </div>
            )}

            {/* Callouts / Notas visuales sólidas */}
            {sec.callout && (
              <div class={`p-5 rounded-2xl border text-xs sm:text-sm font-medium leading-relaxed ${
                sec.callout.type === 'tip'
                  ? 'bg-[#dcfce7] border-[#bbf7d0] text-[#14532d]'
                  : 'bg-[#fef9c3] border-[#fef08a] text-[#713f12]'
              }`}>
                <span class="font-black uppercase tracking-wider block mb-1">
                  {sec.callout.type === 'tip' ? '💡 Consejo Práctico:' : '📌 Nota Técnica:'}
                </span>
                {sec.callout.text}
              </div>
            )}

            {/* Terminal Multi-SO con Pestañas y Copiado Animado Sin Alert */}
            {sec.tabs && sec.tabs.length > 0 && (
              <div class="my-6">
                <CodeTerminal client:load tabs={sec.tabs} title="Terminal / Comandos" />
              </div>
            )}

            {/* In-Article AdBanner a mitad del artículo */}
            {idx === 1 && (
              <div class="my-8">
                <AdBanner format="in-feed" slotId={`guide-${guide.slug}-mid`} />
              </div>
            )}
          </section>
        ))}

        {/* Sección de Preguntas Frecuentes */}
        <section class="pt-8 border-t border-slate-200 space-y-4">
          <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tight">
            Preguntas Frecuentes
          </h2>
          <div class="space-y-4">
            {guide.faqs.map((faq) => (
              <div class="p-6 rounded-2xl border border-slate-200 bg-white shadow-sm">
                <h3 class="text-base font-black text-slate-900">{faq.q}</h3>
                <p class="text-xs sm:text-sm text-slate-600 mt-2 font-medium leading-relaxed">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>

        {/* Etiquetas del Artículo */}
        <div class="pt-6 flex flex-wrap gap-2">
          {guide.tags.map((tag) => (
            <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-700">
              #{tag}
            </span>
          ))}
        </div>

        {/* Banner Inferior y CTA */}
        <div class="p-8 rounded-[2rem] bg-[#f8fafc] border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="text-xl font-black text-slate-900 uppercase">¿Te sirvió esta guía?</h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1 font-medium">
              Explora nuestro catálogo de comparativas o prueba las utilidades gratuitas para seguir aprendiendo.
            </p>
          </div>
          <a
            href="/guias"
            class="shrink-0 px-6 py-3 rounded-full text-xs font-black uppercase bg-black text-white hover:bg-slate-800 transition-all shadow-sm"
          >
            Ver más tutoriales →
          </a>
        </div>

      </article>

    </div>

  </div>
</Layout>
